---
import { getCollection } from 'astro:content';
import { getLegacyDocument } from '../lib/exported-pages.mjs';
import { sortProjects, projectCardsHtml } from '../lib/portfolio-ui.mjs';
import { roofingComparisonHtml } from '../lib/roofing-case-study.mjs';

const all = sortProjects(await getCollection('work', ({ data }) => !data.draft));
const featured = all.filter((project) => project.data.featured).slice(0,3);
if (featured.length !== 3) throw new Error('Expected exactly three featured portfolio projects');
const gallery = getLegacyDocument('index.html')
  .replace('<!--PRUNUS_RECENT_WORK_CARDS-->', projectCardsHtml(featured));
const galleryEnding='<a class="pm-home-work__more" href="/our-work/">See more of our recent work <span aria-hidden="true">→</span></a></div></section>';
if(!gallery.includes(galleryEnding))throw Error('Prunus home work section has changed; avoid placing case study unexpectedly.');
const document=gallery.replace(galleryEnding,galleryEnding+roofingComparisonHtml({id:'prunus-home-roofing',compact:true}));
---
<Fragment set:html={document} />
