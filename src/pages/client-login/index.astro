---
import EditorialLayout from '../../layouts/EditorialLayout.astro';

// Switch to the real Cloudflare Worker only after security, D1/R2, OTP,
// delivery, domain and real client tests have passed. A static preview MUST
// NOT pretend to offer an operational login.
// Configure PUBLIC_PRUNUS_PORTAL_ACTIVE=true in Cloudflare Pages only then.
const ready=import.meta.env.PUBLIC_PRUNUS_PORTAL_ACTIVE === 'true';
const portalOrigin='https://portal.prunusmedia.com/';
const safeOrigin = portalOrigin;
---
{ready ? (
  <html lang="en">
    <head><meta charset="utf-8" /><title>Prunus Client Portal</title>
      <meta name="robots" content="noindex,nofollow" />
      <meta http-equiv="refresh" content={'0;url='+safeOrigin} />
      <link rel="canonical" href={safeOrigin} /></head>
    <body><main><p>Opening your secure Prunus Client Portal…</p>
      <a href={safeOrigin}>Continue to client sign-in</a></main>
      <script is:inline>location.replace('https://portal.prunusmedia.com/');</script>
    </body>
  </html>
) : (
  <EditorialLayout noindex={true} title="Client Portal" description="Prunus Media client access information. Invited website customers receive secure email-code sign-in once their account is activated." pathname="/client-login/">
    <p class="pm-editorial__eyebrow">Prunus Media / Client Portal</p>
    <h1>Your website workspace.</h1>
    <p class="pm-editorial__intro">A shared space for your website enquiries, change requests and updates.</p>
    <p>We’re connecting the secure client sign-in to the new portal. Access is by invitation only, and the portal is not available for customer sign-in yet.</p>
    <p>For existing website requests or questions about access, email <a href="mailto:contactprunusmedia@gmail.com">contactprunusmedia@gmail.com</a>.</p>
    <p><a class="pm-editorial__button" href="/contact/">Contact Prunus Media →</a></p>
  </EditorialLayout>
)}
