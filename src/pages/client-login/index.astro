---
const portalOrigin = 'https://portal.prunusmedia.com/';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>Client login | Prunus Media &amp; UK Trade Websites</title>
    <meta name="description" content="One secure client sign-in for Prunus Media and UK Trade Websites." />
    <link rel="canonical" href={portalOrigin} />
    <meta http-equiv="refresh" content={'0;url='+portalOrigin} />
    <style is:inline>
      body{font:16px/1.6 system-ui,sans-serif;background:#f3efec;color:#203b35;min-height:100vh;display:grid;place-items:center;margin:0}
      main{text-align:center;padding:32px}
      h1{font:normal clamp(32px,6vw,54px)/1.2 Georgia,serif;letter-spacing:-.035em}
      a{color:inherit;font-weight:750;text-underline-offset:4px}
      p{max-width:560px}
    </style>
  </head>
  <body>
    <main>
      <p>PRUNUS MEDIA &nbsp;·&nbsp; UK TRADE WEBSITES</p>
      <h1>Your client portal.</h1>
      <p>Opening your secure shared sign-in.</p>
      <p><a href={portalOrigin}>Continue to client sign-in →</a></p>
    </main>
    <script is:inline>
      const target = new URL('https://portal.prunusmedia.com/');
      const hint = new URL(location.href).searchParams.get('site');
      if (hint && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(hint)) target.searchParams.set('site',hint);
      location.replace(target.toString());
    </script>
  </body>
</html>
