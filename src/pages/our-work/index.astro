---
import { getCollection } from 'astro:content';
import EditorialLayout from '../../layouts/EditorialLayout.astro';

const projects = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => b.data.addedAt.getTime() - a.data.addedAt.getTime());
---
<EditorialLayout title="Websites We Have Built" description="Selected website projects by Prunus Media, including the strategy, design and practical work behind each build." pathname="/our-work/">
  <p class="pm-editorial__eyebrow">Prunus Media / Portfolio</p>
  <h1>Some of our recent work.</h1>
  <p class="pm-editorial__intro">Every business has its own customers and challenges. Here's a closer look at websites we've built and what each project needed to accomplish.</p>
  {projects.length ? <div class="pm-editorial__grid">
    {projects.map((project) => <article class="pm-editorial__card">
      {project.data.image ? <img src={project.data.image} alt={project.data.imageAlt} loading="lazy" /> : <div class="pm-editorial__card-image-empty" aria-hidden="true" />}
      <div class="pm-editorial__card-inner">
        {project.data.category && <p class="pm-editorial__meta">{project.data.category}</p>}
        <h3>{project.data.title}</h3>
        <p>{project.data.summary}</p>
        <a href={'/our-work/' + project.id + '/'}>View project →</a>
      </div>
    </article>)}
  </div> : <p class="pm-editorial__empty">Project profiles will appear here as they are approved for publication.</p>}
  <nav class="pm-editorial__nav" aria-label="Explore Prunus"><a href="/website-design/">Website design</a><a href="/contact/">Start a project</a><a href="/blog/">Journal</a></nav>
</EditorialLayout>
