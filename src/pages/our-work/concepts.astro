---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import data from '../../data/concept-gallery.json';
type Concept={title:string;category:string;description:string;colour:string;image?:string;imageAlt?:string;previewUrl?:string};
const concepts:Concept[]=data;
---
<EditorialLayout title="Website Design Concepts" description="Explore our independent website design concepts for premium trades, wellbeing, creative and service businesses." pathname="/our-work/concepts/">
<p class="pm-editorial__eyebrow">Prunus Media / Design concepts</p><h1>Website design concepts.</h1><p class="pm-editorial__intro">Explore independent design concepts created by our team. These are illustrative website proposals rather than commissioned client projects. Open a concept to explore the design in a new tab.</p><a href="/our-work/" class="pm-editorial__button">Back to our example websites</a><div class="concept-grid">
 {concepts.map(item=><article class="concept-card">
  {item.image ? <img src={item.image} alt={item.imageAlt || item.title+' website screenshot'} width="900" height="520" loading="lazy" decoding="async"/> : <div class="concept-art" style={'--concept-tone:'+item.colour}><small>Design concept</small><strong>{item.category}</strong></div>}
  <div class="concept-copy"><h2>{item.title}</h2><p>{item.description}</p>{item.previewUrl ? <a href={item.previewUrl} rel="nofollow noopener noreferrer" target="_blank">See concept build</a> : <span aria-disabled="true">Preview coming soon</span>}</div>
 </article>)}
</div>
</EditorialLayout>
<style>
.concept-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:32px 0 55px}
.concept-card{background:#fffdfa;border:1px solid #d8d6d0;border-radius:12px;overflow:hidden;display:flex;flex-direction:column;color:#242829}
.concept-art{min-height:155px;padding:24px;display:flex;flex-direction:column;justify-content:space-between;background:var(--concept-tone);color:white}
.concept-art small{color:white;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase}
.concept-art strong{font-size:clamp(1.35rem,2vw,1.8rem);line-height:1.15;font-weight:600;color:white}
.concept-copy{padding:22px;flex:1;display:flex;flex-direction:column;align-items:flex-start}
.concept-copy h2{font-size:1.25rem;margin:0 0 9px;color:#242829}
.concept-copy p{font-size:1rem;line-height:1.55;margin:0 0 16px;color:#454949}
.concept-copy a{margin-top:auto;text-decoration:underline;text-underline-offset:3px;color:#263b36;font-weight:600}
.concept-section{padding:60px 0}
@media(max-width:850px){.concept-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.concept-grid{grid-template-columns:1fr}}
</style>
