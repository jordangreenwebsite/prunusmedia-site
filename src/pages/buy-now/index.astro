---
import CheckoutBrands from '../../components/CheckoutBrands.astro';
import { WEBSITE_CATALOGUE } from '../../../client-portal/src/website-sales-catalogue.js';
const plans=WEBSITE_CATALOGUE;
const brands=[{id:'uk-trades',label:'UK Trade Websites',description:'Straightforward websites for trades.'},{id:'prunus',label:'Prunus Media',description:'Larger, bespoke and search-led websites.'}];
const gbp=(n)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="no-referrer" />
<title>Buy your website | Prunus Media &amp; UK Trade Websites</title>
</head>
<body>
<header><CheckoutBrands /><div class="header-help"><small>Two brands. One team.</small><a href="tel:+447789545807">Call us</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">WhatsApp</a></div></header>
<main>
<section class="intro"><p class="eyebrow">YOUR WEBSITE, SIMPLIFIED</p><h1>Let's make your website a reality.</h1><p>Choose the package that suits your business. Clear payments, proper support and no surprise extras.</p><p class="notice" id="notice" role="status">Enter through your personalised concept link or speak to our team.</p><article id="prospect" class="prospect" hidden><div><p class="eyebrow">PREPARED FOR</p><h2 id="prospect-name"></h2></div><a id="preview" href="/" target="_blank" rel="noopener noreferrer">View your website concept</a></article><div id="offer" class="offer" hidden><p id="offer-title"></p><strong id="countdown" aria-label="Offer time remaining"></strong></div></section>
<section class="layout" aria-label="Choose your package">
<div><h2>Choose your website package</h2><div class="brand-choices" role="group" aria-label="Choose a brand">{brands.map(b=><button type="button" data-brand={b.id} aria-pressed={b.id==='uk-trades'}><b>{b.label}</b><small>{b.description}</small></button>)}</div>
{brands.map(b=><div class="plans" data-catalogue={b.id} hidden={b.id!=='uk-trades'}>{plans.filter(p=>p.brand===b.id).sort((a,b)=>a.id==='seo'?1:b.id==='seo'?-1:0).map(p=><label class="plan"><input type="radio" name="package" value={p.id} checked={p.id==='growth'} disabled={b.id!=='uk-trades'} /><div><b>{p.name}</b><small>{p.pages}</small><p>{p.summary}</p></div><strong data-plan-price={p.id}>{p.from?'From ':''}{gbp(p.price)}{p.kind!=='build'?'/mo':''}</strong></label>)}</div>)}
<p class="fine" id="catalogue-note">UK Trade Websites concept packages. Scope and terms must be agreed before taking payment.</p></div>
<aside><h2>Order summary</h2><p class="fine" id="estimate" hidden>Illustrative starting prices. A fixed project quote must be agreed before payment.</p><dl><div><dt>Website build</dt><dd id="build">£249.00</dd></div><div><dt>At handover</dt><dd id="handover">£163.50</dd></div><div><dt>Ongoing monthly</dt><dd id="monthly">£39.00</dd></div><div class="minimum" hidden><dt id="minimum-label">Minimum commitment</dt><dd id="minimum">£1,170.00</dd></div><div class="total"><dt>Due today</dt><dd id="today">£124.50</dd></div></dl><p id="details">50% deposit today. Remaining 50% plus the first month of hosting at handover.</p><form id="purchase"><label for="buyer-email">Email address</label><input type="email" id="buyer-email" autocomplete="email" required maxlength="254" placeholder="you@yourbusiness.co.uk"/><label class="consent"><input type="checkbox" id="agree" required/><span>I am buying for my business and agree to the stated deposit, handover and monthly payments or six-month SEO commitment, including future charges to my saved payment method.</span></label><button id="pay" type="submit" disabled>Continue to secure payment</button><a id="quote-contact" class="quote-contact wa-link" href="https://wa.me/447789545807" hidden>Discuss this package on WhatsApp</a><p id="payment-message" role="status"></p></form><p class="fine">No VAT is charged as we are not currently VAT registered.</p><div class="questions"><h3>Questions before buying?</h3><p>Speak directly to our team. We're happy to talk through your website and package.</p><div class="help-links"><a href="tel:+447789545807">Call 07789 545807</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">Message on WhatsApp</a></div></div></aside>
</section>
</main><footer>Prunus Media &amp; UK Trade Websites</footer>
<script>
import { WEBSITE_CATALOGUE,catalogueQuote } from '../../../client-portal/src/website-sales-catalogue.js';
const API='https://portal.prunusmedia.com/api/website-sales/';
const ref=new URLSearchParams(location.search).get('ref')||'';
const gbp=(n:number)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
const el=(id:string)=>document.getElementById(id);
const set=(id:string,value:string)=>{const node=el(id);if(node)node.textContent=value;};
const radio=()=>document.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value||'growth';
let quoteData:any=null, skew=0, expired=false, brand='uk-trades';
function selectBrand(next:string){
 if(!['uk-trades','prunus'].includes(next))return;brand=next;
 document.querySelectorAll<HTMLButtonElement>('[data-brand]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.brand===brand)));
 document.querySelectorAll<HTMLElement>('[data-catalogue]').forEach(box=>{const active=box.dataset.catalogue===brand;box.hidden=!active;box.querySelectorAll<HTMLInputElement>('input').forEach(i=>{i.disabled=!active;if(!active)i.checked=false;});});
 if(!document.querySelector('input[name="package"]:checked')){const fallback=document.querySelector<HTMLInputElement>('input[value="'+(brand==='prunus'?'pm-launch':'growth')+'"]');if(fallback)fallback.checked=true;}render();
}
const pay=el('pay') as HTMLButtonElement,form=el('purchase') as HTMLFormElement;
function selected(){const plan=radio();const base=catalogueQuote(plan);const remote=quoteData?.prospect?.brand===brand&&quoteData?.plans?.find((q:any)=>q.plan===plan);return remote?{...base,...remote}:base;}
function render(){
 const q=selected(),plan=WEBSITE_CATALOGUE.find(p=>p.id===q.plan),isSeo=q.plan==='seo',financed=q.plan==='uk-financed',isPmSeo=q.plan==='pm-seo';
 const canPay=!!(q.onlineEligible&&quoteData?.enabled&&quoteData?.prospect?.brand===brand&&quoteData?.plans?.some((p:any)=>p.plan===q.plan));
 const amount=(n:number|null)=>n===null?'Quote separately':gbp(n);
 set('build',q.build===0?(financed?'No upfront build fee':'Included'):amount(q.build));set('handover',amount(q.handover));set('monthly',gbp(q.monthly));set('today',gbp(q.today));
 const row=document.querySelector<HTMLElement>('.minimum');if(row)row.hidden=!q.minimumMonths;
 if(q.minimumMonths){set('minimum-label',q.minimumMonths+'-month minimum');set('minimum',gbp(q.minimumTotal));}
 if(isSeo)set('details','First SEO month today. After six monthly payments, continue SEO for £195/month or choose hosting only at £39/month.');
 else if(financed)set('details','No deposit or separate handover fee. £65/month for the first 12 months, then £39/month. The first £65 is due at sign-up.');
 else if(isPmSeo)set('details','SEO from £195/month with hosting included. Current advertised minimum: three months. New website build quoted separately; standalone hosting £99/month.');
 else set('details','50% deposit today. Remaining 50% plus the first month of hosting at handover. Subsequent hosting is '+gbp(q.monthly)+'/month.'+(brand==='prunus'?' Figures based on the advertised starting price.':''));
 set('catalogue-note',brand==='prunus'?'Prunus Media starting prices. New hosted builds normally have a 12-month hosting term; scope and price require agreement.':'UK Trade Websites packages. No-upfront website spreads the build across 12 months.');
 const estimate=el('estimate');if(estimate)estimate.hidden=brand!=='prunus';
 for(const a of document.querySelectorAll<HTMLAnchorElement>('.wa-link'))a.href='https://wa.me/447789545807?text='+encodeURIComponent('Hi, I have a question about '+(quoteData?.prospect?.name?quoteData.prospect.name+' and ':'')+(plan?.name||'my website')+' with '+(brand==='prunus'?'Prunus Media':'UK Trade Websites')+'.');
 const banner=el('offer');if(banner)banner.hidden=!q.offer;if(q.offer){set('offer-title',q.offer_name||'Limited-time offer');tick();}
 for(const item of WEBSITE_CATALOGUE){const target=document.querySelector<HTMLElement>('[data-plan-price="'+item.id+'"]');if(target){const remote=quoteData?.prospect?.brand===brand&&quoteData?.plans?.find((p:any)=>p.plan===item.id);target.textContent=remote?(item.kind==='seo'?gbp(remote.today)+' today':gbp(remote.build)):(item.from?'From ':'')+gbp(item.price)+(item.kind!=='build'?'/mo':'');}}
 pay.disabled=!canPay||expired;pay.hidden=!q.onlineEligible;
 const contact=el('quote-contact');if(contact)contact.hidden=!!q.onlineEligible;
 const emailField=el('buyer-email') as HTMLInputElement;const agreeField=el('agree') as HTMLInputElement;emailField.disabled=!q.onlineEligible;agreeField.disabled=!q.onlineEligible;emailField.hidden=!q.onlineEligible;
 const label=document.querySelector<HTMLElement>('label[for="buyer-email"]');if(label)label.hidden=!q.onlineEligible;const consent=document.querySelector<HTMLElement>('.consent');if(consent)consent.hidden=!q.onlineEligible;
}
async function refresh(){
 if(!/^[a-f0-9]{64}$/.test(ref))return;
 try{
  const res=await fetch(API+'quote?ref='+encodeURIComponent(ref),{credentials:'omit',cache:'no-store'}),data=await res.json();
  if(!res.ok||!data.ok)throw Error(data.error||'Quote not available.');
  quoteData=data;skew=data.server_time-Date.now();expired=false;selectBrand(data.prospect.brand);
  const section=el('prospect'), preview=el('preview') as HTMLAnchorElement;
  if(section)section.hidden=false;set('prospect-name',data.prospect.name);preview.href=data.prospect.preview_url;
  set('notice',data.enabled?'Your personalised offer. Review your package before paying.':'Your personalised quote. Online payments are not available yet; contact us to get started.');
  render();
 }catch{quoteData=null;set('notice','We could not load your personalised quote. Please contact us to confirm your pricing.');render();}
}
function tick(){
 const q=selected();if(!q.offer)return;
 const left=Math.max(0,Math.ceil((q.offer.end-Date.now()-skew)/1000));
 if(left===0){if(!expired){expired=true;pay.disabled=true;set('countdown','Offer ended. Updating price…');void refresh();}return;}
 const day=Math.floor(left/86400),h=Math.floor(left%86400/3600),m=Math.floor(left%3600/60),s=left%60;
 set('countdown',day+'d '+String(h).padStart(2,'0')+'h '+String(m).padStart(2,'0')+'m '+String(s).padStart(2,'0')+'s');
}
for(const input of document.querySelectorAll<HTMLInputElement>('input[name="package"]'))input.addEventListener('change',render);
form.addEventListener('submit',async e=>{
 e.preventDefault();if(pay.disabled)return;pay.disabled=true;set('payment-message','Opening secure payment…');
 const q=selected();
 try{
   const res=await fetch(API+'checkout',{method:'POST',credentials:'omit',headers:{'content-type':'application/json'},body:JSON.stringify({token:ref,plan:q.plan,email:(el('buyer-email') as HTMLInputElement).value,agree:(el('agree') as HTMLInputElement).checked,today:q.today,handover:q.handover,monthly:q.monthly,offer_id:q.offer?.id||''})});
   const result=await res.json();if(!res.ok||!result.ok)throw Error(result.error||'Checkout unavailable.');
   if(new URL(result.url).origin!=='https://checkout.stripe.com')throw Error('Invalid payment link.');
   location.assign(result.url);
 }catch(e){set('payment-message',e instanceof Error?e.message:'Payment unavailable. Please contact us.');pay.disabled=!quoteData?.enabled||expired;}
});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-brand]'))button.addEventListener('click',()=>selectBrand(button.dataset.brand||'uk-trades'));
selectBrand(new URLSearchParams(location.search).get('brand')==='prunus'?'prunus':'uk-trades');void refresh();window.setInterval(tick,1000);
</script>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#f6f3ed;color:#1d2938;font:16px/1.6 Arial,sans-serif} header,footer{max-width:1180px;margin:auto;padding:22px 30px;display:flex;align-items:center;justify-content:space-between;gap:16px} header{border-bottom:1px solid #dedbd3}.brand{font:600 clamp(19px,3vw,27px)/1.2 Georgia,serif}.brand span{color:#647e91;margin:0 .2em}main{max-width:1180px;margin:0 auto;padding:48px 30px 70px}.intro{max-width:790px;margin:0 0 32px}.eyebrow{font-size:12px;letter-spacing:.14em;color:#516478;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.1;margin:0 0 16px}h1{font-size:clamp(38px,6vw,76px)}h2{font-size:26px}.notice{font-size:14px;color:#475569}.layout{display:grid;grid-template-columns:1.4fr 1fr;gap:28px;align-items:start}.plans{display:grid;gap:12px}.plan{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:start;padding:21px;background:white;border:1px solid #dadfe3;border-radius:12px;cursor:pointer}.plan:has(input:checked){border:2px solid #254762;padding:20px;background:#f4f9fc}.plan input{margin-top:6px;accent-color:#254762}.plan b,.plan small{display:block}.plan p{font-size:14px;margin:7px 0 0;color:#4b5969}.plan strong{white-space:nowrap;color:#173a55}aside{background:#fff;border:1px solid #dedbd3;border-radius:16px;padding:26px;box-shadow:0 16px 45px #173a5510}dl{margin:20px 0}dl div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eceff1}dl div[hidden]{display:none}dd{margin:0;font-weight:700;text-align:right}.total{font-size:24px;color:#173a55;font-weight:700}button{width:100%;padding:15px;background:#173a55;border:none;border-radius:6px;color:white;font-weight:bold}button:disabled{opacity:.62;cursor:not-allowed}.fine{font-size:13px;color:#536274}a{color:#173a55}footer{font-size:13px;border-top:1px solid #dedbd3;color:#536274}@media(max-width:760px){header{align-items:flex-start;flex-direction:column;padding:18px 20px}main{padding:32px 20px 48px}.layout{grid-template-columns:1fr}.plan{padding:15px}.plan:has(input:checked){padding:14px}aside{padding:20px}}
.header-help,.help-links{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.header-help a,.help-links a{padding:8px 13px;border:1px solid #254762;border-radius:6px;text-decoration:none;font-weight:700;font-size:14px}.header-help .wa-link,.help-links .wa-link{background:#e7f1ec;border-color:#426c58;color:#28523e}.questions{margin-top:22px;border-top:1px solid #e4e5e6;padding-top:14px}.questions h3{margin:0;font:600 23px Georgia,serif}.questions p{font-size:14px}form>label{display:block;font-size:14px;font-weight:700}form>input{width:100%;padding:12px;border:1px solid #bbc4cc;border-radius:6px;margin:7px 0 12px;font:inherit}.consent{display:flex;gap:8px;align-items:start;font-weight:400;margin:8px 0 16px;font-size:13px}.consent input{margin-top:4px;accent-color:#254762}.offer,.prospect{margin:18px 0;padding:20px;border-radius:10px}.offer{background:#173a55;color:#fff}.offer p{margin:0}.offer strong{font-size:24px;font-variant-numeric:tabular-nums}.prospect{border:1px solid #dedbd3;background:white;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.prospect[hidden],.offer[hidden]{display:none}.prospect h2{margin-bottom:0}#payment-message{font-size:13px}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #557d98;outline-offset:3px}.brand-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 18px}.brand-choices button{background:#fff;color:#173a55;border:1px solid #d3d8dc;text-align:left;padding:14px;cursor:pointer}.brand-choices button[data-brand="prunus"]{color:#965b68}.brand-choices button[aria-pressed="true"]{border:2px solid currentColor;padding:13px;background:#f0f5f9}.brand-choices button[data-brand="prunus"][aria-pressed="true"]{background:#f8edef}.brand-choices b,.brand-choices small{display:block}.brand-choices small{margin-top:5px;font-weight:400;font-size:12px;line-height:1.45}.plans[hidden],form [hidden]{display:none!important}.quote-contact{display:block;background:#e7f1ec;color:#28523e;border:1px solid #426c58;border-radius:6px;text-align:center;text-decoration:none;padding:14px;font-weight:bold}.quote-contact[hidden]{display:none!important}</style>
</body></html>
