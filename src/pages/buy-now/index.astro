---
import { CONCEPT_PLANS, quoteWebsite } from '../../../client-portal/src/website-checkout-pricing.js';
const plans = Object.entries(CONCEPT_PLANS).map(([id,plan])=>({id,...plan,quote:quoteWebsite(id)}));
const gbp=(n)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="no-referrer" />
<title>Buy your website | Prunus Media &amp; UK Trade Websites</title>
</head>
<body>
<header><div class="brand">Prunus Media <span>+</span> UK Trade Websites</div><div class="header-help"><small>Two brands. One team.</small><a href="tel:+447789545807">Call us</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">WhatsApp</a></div></header>
<main>
<section class="intro"><p class="eyebrow">YOUR WEBSITE, SIMPLIFIED</p><h1>Let's make your website a reality.</h1><p>Choose the package that suits your business. Clear payments, proper support and no surprise extras.</p><p class="notice" id="notice" role="status">Enter through your personalised concept link or speak to our team.</p><article id="prospect" class="prospect" hidden><div><p class="eyebrow">PREPARED FOR</p><h2 id="prospect-name"></h2></div><a id="preview" href="/" target="_blank" rel="noopener noreferrer">View your website concept</a></article><div id="offer" class="offer" hidden><p id="offer-title"></p><strong id="countdown" aria-label="Offer time remaining"></strong></div></section>
<section class="layout" aria-label="Choose your package">
<div><h2>Choose your website package</h2><div class="plans">
{plans.map((p)=><label class="plan"><input type="radio" name="package" value={p.id} checked={p.id==='growth'} /><div><b>{p.name}</b><small>{p.pages}</small><p>{p.id==='seo'?'Website build and hosting included while SEO is active. Six-month minimum.':'Professional design, mobile friendly and ready for enquiries.'}</p></div><strong data-plan-price={p.id}>{p.id==='seo'?'£195/mo':gbp(p.build)}</strong></label>)}
</div><p class="fine">These packages are for eligible concept projects. Larger or bespoke projects are quoted separately. Scope, terms and payment authorisation will be agreed before taking payment.</p></div>
<aside><h2>Order summary</h2><dl><div><dt>Website build</dt><dd id="build">£249.00</dd></div><div><dt>At handover</dt><dd id="handover">£163.50</dd></div><div><dt>Ongoing monthly</dt><dd id="monthly">£39.00</dd></div><div class="minimum" hidden><dt>Six-month minimum</dt><dd id="minimum">£1,170.00</dd></div><div class="total"><dt>Due today</dt><dd id="today">£124.50</dd></div></dl><p id="details">50% deposit today. Remaining 50% plus the first month of hosting at handover.</p><form id="purchase"><label for="buyer-email">Email address</label><input type="email" id="buyer-email" autocomplete="email" required maxlength="254" placeholder="you@yourbusiness.co.uk"/><label class="consent"><input type="checkbox" id="agree" required/><span>I am buying for my business and agree to the stated deposit, handover and monthly payments or six-month SEO commitment, including future charges to my saved payment method.</span></label><button id="pay" type="submit" disabled>Continue to secure payment</button><p id="payment-message" role="status"></p></form><p class="fine">No VAT is charged as we are not currently VAT registered.</p><div class="questions"><h3>Questions before buying?</h3><p>Speak directly to our team. We're happy to talk through your website and package.</p><div class="help-links"><a href="tel:+447789545807">Call 07789 545807</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">Message on WhatsApp</a></div></div></aside>
</section>
</main><footer>Prunus Media &amp; UK Trade Websites</footer>
<script>
import { quoteWebsite } from '../../../client-portal/src/website-checkout-pricing.js';
const API='https://portal.prunusmedia.com/api/website-sales/';
const ref=new URLSearchParams(location.search).get('ref')||'';
const gbp=(n:number)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
const el=(id:string)=>document.getElementById(id);
const set=(id:string,value:string)=>{const node=el(id);if(node)node.textContent=value;};
const radio=()=>document.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value||'growth';
let quoteData:any=null, skew=0, expired=false;
const pay=el('pay') as HTMLButtonElement,form=el('purchase') as HTMLFormElement;
function selected(){return quoteData?.plans?.find((q:any)=>q.plan===radio())||quoteWebsite(radio());}
function render(){
 const q=selected(),isSeo=q.plan==='seo';
 set('build',q.build===0?'Included':gbp(q.build));set('handover',gbp(q.handover));set('monthly',gbp(q.monthly));set('today',gbp(q.today));
 const row=document.querySelector<HTMLElement>('.minimum');if(row)row.hidden=!isSeo;
 if(isSeo){set('minimum',gbp(q.minimumTotal??117000));set('details','First SEO month today. After six monthly payments, continue SEO for £195/month or choose hosting only at £39/month.');}
 else set('details','50% deposit today. Remaining 50% plus the first month of hosting at handover. Subsequent hosting is £39/month.');
 for(const a of document.querySelectorAll<HTMLAnchorElement>('.wa-link'))a.href='https://wa.me/447789545807?text='+encodeURIComponent('Hi, I have a question about '+(quoteData?.prospect?.name?quoteData.prospect.name+' and ':'')+(isSeo?'the Website + SEO package':q.plan==='starter'?'the Starter Website package':'the Trade Growth Website package')+'.');
 const banner=el('offer');if(banner)banner.hidden=!q.offer;
 if(q.offer){set('offer-title',q.offer_name||'Limited-time offer');tick();}
 for(const item of quoteData?.plans||[]){const target=document.querySelector<HTMLElement>('[data-plan-price="'+item.plan+'"]');if(target)target.textContent=item.plan==='seo'?gbp(item.today)+' today':gbp(item.build);}
 pay.disabled=!quoteData?.enabled||expired;
}
async function refresh(){
 if(!/^[a-f0-9]{64}$/.test(ref))return;
 try{
  const res=await fetch(API+'quote?ref='+encodeURIComponent(ref),{credentials:'omit',cache:'no-store'}),data=await res.json();
  if(!res.ok||!data.ok)throw Error(data.error||'Quote not available.');
  quoteData=data;skew=data.server_time-Date.now();expired=false;
  const section=el('prospect'), preview=el('preview') as HTMLAnchorElement;
  if(section)section.hidden=false;set('prospect-name',data.prospect.name);preview.href=data.prospect.preview_url;
  set('notice',data.enabled?'Your personalised offer. Review your package before paying.':'Your personalised quote. Online payments are not available yet; contact us to get started.');
  render();
 }catch{quoteData=null;set('notice','We could not load your personalised quote. Please contact us to confirm your pricing.');render();}
}
function tick(){
 const q=selected();if(!q.offer)return;
 const left=Math.max(0,Math.ceil((q.offer.end-Date.now()-skew)/1000));
 if(left===0){if(!expired){expired=true;pay.disabled=true;set('countdown','Offer ended. Updating price…');void refresh();}return;}
 const day=Math.floor(left/86400),h=Math.floor(left%86400/3600),m=Math.floor(left%3600/60),s=left%60;
 set('countdown',day+'d '+String(h).padStart(2,'0')+'h '+String(m).padStart(2,'0')+'m '+String(s).padStart(2,'0')+'s');
}
for(const input of document.querySelectorAll<HTMLInputElement>('input[name="package"]'))input.addEventListener('change',render);
form.addEventListener('submit',async e=>{
 e.preventDefault();if(pay.disabled)return;pay.disabled=true;set('payment-message','Opening secure payment…');
 const q=selected();
 try{
   const res=await fetch(API+'checkout',{method:'POST',credentials:'omit',headers:{'content-type':'application/json'},body:JSON.stringify({token:ref,plan:q.plan,email:(el('buyer-email') as HTMLInputElement).value,agree:(el('agree') as HTMLInputElement).checked,today:q.today,handover:q.handover,monthly:q.monthly,offer_id:q.offer?.id||''})});
   const result=await res.json();if(!res.ok||!result.ok)throw Error(result.error||'Checkout unavailable.');
   if(new URL(result.url).origin!=='https://checkout.stripe.com')throw Error('Invalid payment link.');
   location.assign(result.url);
 }catch(e){set('payment-message',e instanceof Error?e.message:'Payment unavailable. Please contact us.');pay.disabled=!quoteData?.enabled||expired;}
});
render();void refresh();window.setInterval(tick,1000);
</script>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#f6f3ed;color:#1d2938;font:16px/1.6 Arial,sans-serif} header,footer{max-width:1180px;margin:auto;padding:22px 30px;display:flex;align-items:center;justify-content:space-between;gap:16px} header{border-bottom:1px solid #dedbd3}.brand{font:600 clamp(19px,3vw,27px)/1.2 Georgia,serif}.brand span{color:#647e91;margin:0 .2em}main{max-width:1180px;margin:0 auto;padding:48px 30px 70px}.intro{max-width:790px;margin:0 0 32px}.eyebrow{font-size:12px;letter-spacing:.14em;color:#516478;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.1;margin:0 0 16px}h1{font-size:clamp(38px,6vw,76px)}h2{font-size:26px}.notice{font-size:14px;color:#475569}.layout{display:grid;grid-template-columns:1.4fr 1fr;gap:28px;align-items:start}.plans{display:grid;gap:12px}.plan{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:start;padding:21px;background:white;border:1px solid #dadfe3;border-radius:12px;cursor:pointer}.plan:has(input:checked){border:2px solid #254762;padding:20px;background:#f4f9fc}.plan input{margin-top:6px;accent-color:#254762}.plan b,.plan small{display:block}.plan p{font-size:14px;margin:7px 0 0;color:#4b5969}.plan strong{white-space:nowrap;color:#173a55}aside{background:#fff;border:1px solid #dedbd3;border-radius:16px;padding:26px;box-shadow:0 16px 45px #173a5510}dl{margin:20px 0}dl div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eceff1}dl div[hidden]{display:none}dd{margin:0;font-weight:700;text-align:right}.total{font-size:24px;color:#173a55;font-weight:700}button{width:100%;padding:15px;background:#173a55;border:none;border-radius:6px;color:white;font-weight:bold}button:disabled{opacity:.62;cursor:not-allowed}.fine{font-size:13px;color:#536274}a{color:#173a55}footer{font-size:13px;border-top:1px solid #dedbd3;color:#536274}@media(max-width:760px){header{align-items:flex-start;flex-direction:column;padding:18px 20px}main{padding:32px 20px 48px}.layout{grid-template-columns:1fr}.plan{padding:15px}.plan:has(input:checked){padding:14px}aside{padding:20px}}
.header-help,.help-links{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.header-help a,.help-links a{padding:8px 13px;border:1px solid #254762;border-radius:6px;text-decoration:none;font-weight:700;font-size:14px}.header-help .wa-link,.help-links .wa-link{background:#e7f1ec;border-color:#426c58;color:#28523e}.questions{margin-top:22px;border-top:1px solid #e4e5e6;padding-top:14px}.questions h3{margin:0;font:600 23px Georgia,serif}.questions p{font-size:14px}form>label{display:block;font-size:14px;font-weight:700}form>input{width:100%;padding:12px;border:1px solid #bbc4cc;border-radius:6px;margin:7px 0 12px;font:inherit}.consent{display:flex;gap:8px;align-items:start;font-weight:400;margin:8px 0 16px;font-size:13px}.consent input{margin-top:4px;accent-color:#254762}.offer,.prospect{margin:18px 0;padding:20px;border-radius:10px}.offer{background:#173a55;color:#fff}.offer p{margin:0}.offer strong{font-size:24px;font-variant-numeric:tabular-nums}.prospect{border:1px solid #dedbd3;background:white;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.prospect[hidden],.offer[hidden]{display:none}.prospect h2{margin-bottom:0}#payment-message{font-size:13px}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #557d98;outline-offset:3px}</style>
</body></html>
