---
import CheckoutBrands from '../../components/CheckoutBrands.astro';
import { EXTRAS,SOURCES } from '../../../client-portal/src/website-sales-extras.js';
import { WEBSITE_CATALOGUE } from '../../../client-portal/src/website-sales-catalogue.js';
const plans=WEBSITE_CATALOGUE;
const brands=[{id:'uk-trades',label:'UK Trade Websites',description:'Straightforward websites for trades.'},{id:'prunus',label:'Prunus Media',description:'Larger, bespoke and search-led websites.'}];
const gbp=(n)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="no-referrer" />
<title>Buy your website | Prunus Media &amp; UK Trade Websites</title>
</head>
<body>
<header><CheckoutBrands /><div class="header-help"><small>Two brands. One team.</small><a href="tel:+447789545807">Call us</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">WhatsApp</a></div></header>
<main>
<section class="intro"><p class="eyebrow">YOUR WEBSITE, SIMPLIFIED</p><h1>Let's make your website a reality.</h1><p>Choose the package that suits your business. Clear payments, proper support and no surprise extras.</p><p class="notice" id="notice" role="status">Choose a package below. If you do not have a personalised link, contact us to confirm the scope and receive your secure payment link.</p><article id="prospect" class="prospect" hidden><div><p class="eyebrow">PREPARED FOR</p><h2 id="prospect-name"></h2></div><a id="preview" href="/" target="_blank" rel="noopener noreferrer">View your website concept</a></article><div id="offer" class="offer" hidden><p id="offer-title"></p><strong id="countdown" aria-label="Offer time remaining"></strong></div></section>
<section class="layout" aria-label="Choose your package">
<div><h2>Choose your website package</h2><div class="brand-choices" role="group" aria-label="Choose a brand">{brands.map(b=><button type="button" data-brand={b.id} aria-pressed={b.id==='uk-trades'}><b>{b.label}</b><small>{b.description}</small></button>)}</div>
{brands.map(b=><div class="plans" data-catalogue={b.id} hidden={b.id!=='uk-trades'}>{plans.filter(p=>p.brand===b.id).sort((a,b)=>a.id==='seo'?1:b.id==='seo'?-1:0).map(p=><label class="plan"><input type="radio" name="package" value={p.id} checked={p.id==='growth'} disabled={b.id!=='uk-trades'} /><div><b>{p.name}</b><small>{p.pages}</small><p>{p.summary}</p></div><strong data-plan-price={p.id}>{p.from?'From ':''}{gbp(p.price)}{p.kind!=='build'?'/mo':''}</strong></label>)}</div>)}
<p class="fine" id="catalogue-note">UK Trade Websites concept packages. Scope and terms must be agreed before taking payment.</p>
<section class="extras-guide" id="extras-guide" hidden aria-labelledby="extras-heading"><p class="eyebrow">ONLY IF YOU NEED THEM</p><h2 id="extras-heading">A few optional extras</h2><p>Already got everything you need? Skip this section. Nothing is added automatically.</p><div id="basic-extras">{EXTRAS.filter(e=>!e.agency).map(e=><fieldset class="extra-card" data-extra={e.id} hidden><legend>{e.title}</legend><p class="extra-price">{e.price}</p><div class="extra-choices">{[["yes","Yes"],["unsure","Not sure"],["no","No"]].map(([v,label])=><label><input type="radio" name={"extra-"+e.id} value={v}/><span>{label}</span></label>)}</div><p class="extra-answer" data-answer={e.id} aria-live="polite" hidden></p></fieldset>)}</div><details id="agency-extras" hidden><summary>Explore other optional services</summary>{EXTRAS.filter(e=>e.agency).map(e=><fieldset class="extra-card" data-extra={e.id} hidden><legend>{e.title}</legend><p class="extra-price">{e.price}</p><div class="extra-choices">{[["yes","Yes"],["unsure","Not sure"],["no","No"]].map(([v,label])=><label><input type="radio" name={"extra-"+e.id} value={v}/><span>{label}</span></label>)}</div><p class="extra-answer" data-answer={e.id} aria-live="polite" hidden></p></fieldset>)}</details><label class="referral-label" for="referral">How did you hear about us? <small>(optional)</small></label><select id="referral"><option value="">Prefer not to say</option>{SOURCES.map(s=><option value={s}>{s}</option>)}</select></section>
<section class="care-guide" aria-labelledby="care-heading">
  <p class="eyebrow">AFTER YOUR WEBSITE GOES LIVE</p>
  <h2 id="care-heading">What are you paying for each month?</h2>
  <p>A website needs hosting to stay online. Your monthly payment covers the infrastructure that serves your website, along with ongoing care from our team. You do not need to arrange separate hosting.</p>
  <div class="care-grid">
    <article class="care-card">
      <div class="care-title"><h3>UK Trade Websites</h3><strong>£39<small>/month</small></strong></div>
      <p class="care-sub">Essential hosting and technical care</p>
      <ul>
        <li>Website hosting and SSL (the secure HTTPS connection).</li>
        <li>Technical upkeep to keep your website accessible and working.</li>
        <li>Help resolving hosting-related faults and broken website functionality.</li>
        <li>Technical support if something goes wrong with your website.</li>
      </ul>
      <p class="care-note">Designed for straightforward trade websites. Ongoing keyword research, new content and SEO reporting are not included in this plan.</p>
    </article>
    <article class="care-card care-prunus">
      <div class="care-title"><h3>Prunus Media</h3><strong>£99<small>/month</small></strong></div>
      <p class="care-sub">Hosting with proactive website care</p>
      <ul>
        <li>Everything included in essential hosting.</li>
        <li>Regular checks of website health, broken links and enquiry forms.</li>
        <li>Checks of your existing target keywords and Google search visibility.</li>
        <li>A report every three months covering website and search performance, with recommendations for improvements.</li>
      </ul>
      <p class="care-note">The difference is the time spent reviewing your website and identifying improvements, not simply the cost of hosting a larger site.</p>
    </article>
    <article class="care-card care-seo">
      <div class="care-title"><h3>Website + ongoing SEO</h3><strong>£195<small>/month</small></strong></div>
      <p class="care-sub">Available with either brand. Hosting included.</p>
      <ul>
        <li>UK Trade Websites: initial website of up to 9 pages, with no upfront build fee. Prunus Media: website build quoted separately.</li><li>New service and location pages added where appropriate for SEO. SEO-led expansion never changes your agreed hosting rate.</li>
        <li>Two original, relevant blog articles written and published each week.</li>
        <li>Monthly research and tracking for up to five agreed target keywords, including new search opportunities. Additional keyword tracking is available separately.</li>
        <li>Monthly website updates based on findings, including improvements to existing page content, headings and internal links.</li>
        <li>Monthly reporting on keyword positions, search visibility, website performance, work completed and recommended next steps.</li>
      </ul>
      <p class="care-note">Six-month minimum. Hosting is included while SEO is active, so you do not pay a separate £39 or £99 hosting fee. Search rankings are not guaranteed.</p>
    </article>
  </div>
  <p class="fine care-foot">Domain registration, major redesigns, new functionality and work outside your agreed package are discussed and priced separately. The financed UK Trade Websites plan includes build repayments for the first 12 months.</p>
</section></div>
<aside><h2>Order summary</h2><p class="fine" id="estimate" hidden>Illustrative starting prices. A fixed project quote must be agreed before payment.</p><dl><div><dt>Website build</dt><dd id="build">£249.00</dd></div><div><dt>At handover</dt><dd id="handover">£163.50</dd></div><div><dt>Ongoing monthly</dt><dd id="monthly">£39.00</dd></div><div class="minimum" hidden><dt id="minimum-label">Minimum commitment</dt><dd id="minimum">£1,170.00</dd></div><div class="total"><dt>Due today</dt><dd id="today">£124.50</dd></div></dl><div id="extras-estimate" class="extras-estimate" hidden aria-live="polite"><h3>Optional extras estimate</h3><dl><div><dt>Extra one-off costs (from)</dt><dd id="extra-once">£0</dd></div><div><dt>Extra annual costs (from)</dt><dd id="extra-annual">£0</dd></div><div><dt>Extra monthly costs (from)</dt><dd id="extra-monthly">£0</dd></div><div><dt>Estimated package + monthly extras</dt><dd id="extra-combined">£0</dd></div></dl><p class="fine">These extras are not part of the base payment. We confirm exact scope, renewal dates and pricing with you before charging anything.</p></div><p id="details">50% deposit today. Remaining 50% plus the first month of hosting at handover.</p><form id="purchase"><label for="buyer-email">Email address</label><input type="email" id="buyer-email" autocomplete="email" required maxlength="254" placeholder="you@yourbusiness.co.uk"/><label class="consent"><input type="checkbox" id="agree" required data-terms-version={"website-packages-2026-11-18-v3"}/><span id="agreement-text">I agree to the payment terms shown above.</span></label><button id="pay" type="submit" disabled>Continue to secure payment</button><a id="quote-contact" class="quote-contact wa-link" href="https://wa.me/447789545807" hidden>Discuss this package on WhatsApp</a><p id="payment-message" role="status"></p></form><p class="fine">No VAT is charged as we are not currently VAT registered.</p><div class="questions"><h3>Questions before buying?</h3><p>Speak directly to our team. We're happy to talk through your website and package.</p><div class="help-links"><a href="tel:+447789545807">Call 07789 545807</a><a class="wa-link" href="https://wa.me/447789545807?text=Hi%2C%20I%20have%20a%20question%20about%20my%20website.">Message on WhatsApp</a></div></div></aside>
</section>
</main><footer>Prunus Media &amp; UK Trade Websites</footer>
<script>
import { eligibleExtras,estimateExtras } from '../../../client-portal/src/website-sales-extras.js';
import { WEBSITE_CATALOGUE,catalogueQuote,agreementFor,AGREEMENT_VERSION } from '../../../client-portal/src/website-sales-catalogue.js';
const API='https://portal.prunusmedia.com/api/website-sales/';
const ref=new URLSearchParams(location.search).get('ref')||'';
const concept=new URLSearchParams(location.search).get('concept')||'';
const gbp=(n:number)=>new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(n/100);
const el=(id:string)=>document.getElementById(id);
const set=(id:string,value:string)=>{const node=el(id);if(node)node.textContent=value;};
const radio=()=>document.querySelector<HTMLInputElement>('input[name="package"]:checked')?.value||'growth';
let quoteData:any=null, skew=0, expired=false, brand='uk-trades';
let disabledExtras:string[]=[], extrasReady=false;
const answers=()=>Object.fromEntries(Array.from(document.querySelectorAll<HTMLInputElement>('[data-extra]:not([hidden]) input:checked')).map(i=>[i.name.slice(6),i.value]));
const referral=()=>((el('referral') as HTMLSelectElement)?.value||'');
function renderExtras(plan:string,monthly:number){const items=extrasReady?eligibleExtras(brand,plan,disabledExtras):[];const allowed=new Set(items.map(e=>e.id));document.querySelectorAll<HTMLFieldSetElement>('[data-extra]').forEach(box=>{box.hidden=!allowed.has(box.dataset.extra||'');if(box.hidden)box.querySelectorAll<HTMLInputElement>('input:checked').forEach(i=>i.checked=false);});const guide=el('extras-guide'),agency=el('agency-extras');if(guide)guide.hidden=!extrasReady;if(agency)agency.hidden=!items.some(e=>e.agency);const a=answers();for(const item of items){const msg=document.querySelector<HTMLElement>('[data-answer="'+item.id+'"]');if(msg){msg.hidden=!a[item.id];msg.textContent=a[item.id]?String(item[a[item.id] as 'yes'|'no'|'unsure']||''):'';}}const totals=estimateExtras(items,a);const est=el('extras-estimate');if(est)est.hidden=!totals.selected.length;set('extra-once',gbp(totals.once));set('extra-monthly',gbp(totals.monthly));set('extra-annual',gbp(totals.annual));set('extra-combined',gbp(monthly+totals.monthly));return {items,a,totals};}
async function loadExtras(){try{const res=await fetch(API+'extras',{credentials:'omit',cache:'no-store'}),data=await res.json();if(!res.ok||!data.ok||!Array.isArray(data.disabled))return;disabledExtras=data.disabled;extrasReady=true;render();}catch{}}
function selectBrand(next:string){
 if(!['uk-trades','prunus'].includes(next))return;brand=next;
 document.querySelectorAll<HTMLButtonElement>('[data-brand]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.brand===brand)));
 document.querySelectorAll<HTMLElement>('[data-catalogue]').forEach(box=>{const active=box.dataset.catalogue===brand;box.hidden=!active;box.querySelectorAll<HTMLInputElement>('input').forEach(i=>{i.disabled=!active;if(!active)i.checked=false;});});
 if(!document.querySelector('input[name="package"]:checked')){const fallback=document.querySelector<HTMLInputElement>('input[value="'+(brand==='prunus'?'pm-launch':'growth')+'"]');if(fallback)fallback.checked=true;}render();
}
const pay=el('pay') as HTMLButtonElement,form=el('purchase') as HTMLFormElement;
function selected(){const plan=radio();const base=catalogueQuote(plan);const remote=quoteData?.plans?.find((q:any)=>q.plan===plan);return remote?{...base,...remote}:base;}
function render(){
 (el('agree') as HTMLInputElement).checked=false;
 const q=selected(),plan=WEBSITE_CATALOGUE.find(p=>p.id===q.plan),isSeo=q.plan==='seo',financed=q.plan==='uk-financed',isPmSeo=q.plan==='pm-seo';
 const extra=renderExtras(q.plan,q.monthly);
 const needsQuote=extra.totals.selected.length>0;
 const canPay=!!(!needsQuote&&plan?.onlineEligible&&q.onlineEligible&&quoteData?.agreement_version===AGREEMENT_VERSION&&quoteData?.enabled&&quoteData?.enabled_plans?.includes(q.plan));
 const paymentOption=!!canPay;
 set('agreement-text',agreementFor(q));
 const amount=(n:number|null)=>n===null?'Quote separately':gbp(n);
 set('build',q.build===0?(financed?'No upfront build fee':'Included'):amount(q.build));set('handover',amount(q.handover));set('monthly',gbp(q.monthly));set('today',canPay?gbp(q.today):'Confirm with us');
 const row=document.querySelector<HTMLElement>('.minimum');if(row)row.hidden=!q.minimumMonths;
 if(q.minimumMonths){set('minimum-label',q.minimumMonths+'-month minimum');set('minimum',gbp(q.minimumTotal));}
 if(isSeo)set('details','Initial trade website of up to 9 pages, ongoing SEO and hosting included. No upfront build fee. After six monthly payments, continue SEO at £195/month or choose hosting only at £39/month. SEO-led growth does not change your agreed hosting rate.');
 else if(financed)set('details','No deposit or separate handover fee. £65/month for the first 12 months, then £39/month. The first £65 is due at sign-up.');
 else if(isPmSeo)set('details','Ongoing SEO and managed hosting for £195/month with a six-month minimum. Any new website build is quoted separately. After the minimum, continue SEO or choose hosting only at your agreed rate (standard £99/month).');
 else set('details','50% deposit today. Remaining 50% plus the first month of hosting at handover. Subsequent hosting is '+gbp(q.monthly)+'/month.'+(brand==='prunus'?' Figures based on the advertised starting price.':''));
 set('catalogue-note',brand==='prunus'?'Prunus Media one-off builds have starting prices and normally a 12-month hosting term. The £195/month ongoing SEO service includes hosting, not the initial build; six-month SEO minimum.':'UK Trade Websites: typically up to 9 initial pages. No-upfront financing spreads the build across 12 months. Larger bespoke initial builds are suited to Prunus Media.');
 const estimate=el('estimate');if(estimate)estimate.hidden=brand!=='prunus'||isPmSeo;
 for(const a of document.querySelectorAll<HTMLAnchorElement>('.wa-link'))a.href='https://wa.me/447789545807?text='+encodeURIComponent('Hi, I have a question about '+(quoteData?.prospect?.name?quoteData.prospect.name+' and ':'')+(plan?.name||'my website')+' with '+(brand==='prunus'?'Prunus Media':'UK Trade Websites')+'.');
 const banner=el('offer');if(banner)banner.hidden=!q.offer;if(q.offer){set('offer-title',q.offer_name||'Limited-time offer');tick();}
 for(const item of WEBSITE_CATALOGUE){const target=document.querySelector<HTMLElement>('[data-plan-price="'+item.id+'"]');if(target){const remote=quoteData?.plans?.find((p:any)=>p.plan===item.id);target.textContent=remote?(item.kind==='seo'||item.kind==='financed'?(item.from?'From ':'')+gbp(remote.monthly)+'/mo':(item.from?'From ':'')+gbp(remote.build)):(item.from?'From ':'')+gbp(item.price)+(item.kind!=='build'?'/mo':'');}}
 pay.disabled=!canPay||expired;pay.hidden=!paymentOption;
 const contact=el('quote-contact');if(contact){contact.hidden=canPay;contact.textContent=needsQuote?'Confirm optional extras and payment link':quoteData?'Discuss this package on WhatsApp':'Request your secure payment link';const link=contact as HTMLAnchorElement;const details=extra.items.filter(e=>extra.a[e.id]&&extra.a[e.id]!=='no').map(e=>e.short+': '+(extra.a[e.id]==='yes'?e.price:'Not sure'));link.href='https://wa.me/447789545807?text='+encodeURIComponent('Hi, I would like to discuss '+(plan?.name||'a website')+' with '+(brand==='prunus'?'Prunus Media':'UK Trade Websites')+(quoteData?.prospect?.name?' for '+quoteData.prospect.name:'')+'.'+(details.length?'\nOptional extras: '+details.join('; '):'')+(referral()?'\nHeard about you: '+referral():''));}
 const emailField=el('buyer-email') as HTMLInputElement;const agreeField=el('agree') as HTMLInputElement;emailField.disabled=!paymentOption;agreeField.disabled=!paymentOption;emailField.hidden=!paymentOption;
 const label=document.querySelector<HTMLElement>('label[for="buyer-email"]');if(label)label.hidden=!paymentOption;const consent=document.querySelector<HTMLElement>('.consent');if(consent)consent.hidden=!paymentOption;
}
async function refresh(){
 if(!/^[a-f0-9]{64}$/.test(ref)&&!/^[a-z0-9][a-z0-9-]{0,100}$/.test(concept))return;
 try{
  const res=await fetch(API+'quote?'+(ref?'ref='+encodeURIComponent(ref):'concept='+encodeURIComponent(concept)),{credentials:'omit',cache:'no-store'}),data=await res.json();
  if(!res.ok||!data.ok)throw Error(data.error||'Quote not available.');
  quoteData=data;skew=data.server_time-Date.now();expired=false;selectBrand(new URLSearchParams(location.search).get('brand')==='prunus'?'prunus':new URLSearchParams(location.search).get('brand')==='uk-trades'?'uk-trades':data.prospect.brand);
  const section=el('prospect'), preview=el('preview') as HTMLAnchorElement;
  if(section)section.hidden=false;set('prospect-name',data.prospect.name);preview.href=data.prospect.preview_url;
  set('notice',data.enabled?'Your personalised offer. Review your package before paying.':'Your personalised quote. Online payments are not available yet; contact us to get started.');
  render();
 }catch{quoteData=null;set('notice','We could not load your personalised quote. Please contact us to confirm your pricing.');render();}
}
function tick(){
 const q=selected();if(!q.offer)return;
 const left=Math.max(0,Math.ceil((q.offer.end-Date.now()-skew)/1000));
 if(left===0){if(!expired){expired=true;pay.disabled=true;set('countdown','Offer ended. Updating price…');void refresh();}return;}
 const day=Math.floor(left/86400),h=Math.floor(left%86400/3600),m=Math.floor(left%3600/60),s=left%60;
 set('countdown',day+'d '+String(h).padStart(2,'0')+'h '+String(m).padStart(2,'0')+'m '+String(s).padStart(2,'0')+'s');
}
for(const input of document.querySelectorAll<HTMLInputElement>('input[name="package"]'))input.addEventListener('change',render);
form.addEventListener('submit',async e=>{
 e.preventDefault();if(pay.disabled)return;pay.disabled=true;set('payment-message','Opening secure payment…');
 const q=selected();
 try{
   const res=await fetch(API+'checkout',{method:'POST',credentials:'omit',headers:{'content-type':'application/json'},body:JSON.stringify({token:ref,concept,plan:q.plan,email:(el('buyer-email') as HTMLInputElement).value,agree:(el('agree') as HTMLInputElement).checked,agreement_version:(el('agree') as HTMLInputElement).dataset.termsVersion,today:q.today,handover:q.handover,monthly:q.monthly,offer_id:q.offer?.id||'',extras:answers(),referral:referral()})});
   const result=await res.json();if(!res.ok||!result.ok)throw Error(result.error||'Checkout unavailable.');
   if(new URL(result.url).origin!=='https://checkout.stripe.com')throw Error('Invalid payment link.');
   location.assign(result.url);
 }catch(e){set('payment-message',e instanceof Error?e.message:'Payment unavailable. Please contact us.');pay.disabled=!quoteData?.enabled_plans?.includes(q.plan)||expired;}
});
for(const button of document.querySelectorAll<HTMLButtonElement>('[data-brand]'))button.addEventListener('click',()=>selectBrand(button.dataset.brand||'uk-trades'));
selectBrand(new URLSearchParams(location.search).get('brand')==='prunus'?'prunus':'uk-trades');const requestedPlan=new URLSearchParams(location.search).get('plan');const requestedInput=Array.from(document.querySelectorAll<HTMLInputElement>('input[name="package"]')).find(i=>i.value===requestedPlan&&!i.disabled);if(requestedInput){requestedInput.checked=true;render();}void refresh();void loadExtras();document.querySelectorAll<HTMLInputElement>('[data-extra] input').forEach(i=>i.addEventListener('change',render));el('referral')?.addEventListener('change',render);window.setInterval(tick,1000);
</script>
<style>
:global(*){box-sizing:border-box} :global(body){margin:0;background:#f6f3ed;color:#1d2938;font:16px/1.6 Arial,sans-serif} header,footer{max-width:1180px;margin:auto;padding:22px 30px;display:flex;align-items:center;justify-content:space-between;gap:16px} header{border-bottom:1px solid #dedbd3}.brand{font:600 clamp(19px,3vw,27px)/1.2 Georgia,serif}.brand span{color:#647e91;margin:0 .2em}main{max-width:1180px;margin:0 auto;padding:48px 30px 70px}.intro{max-width:790px;margin:0 0 32px}.eyebrow{font-size:12px;letter-spacing:.14em;color:#516478;font-weight:700}h1,h2{font-family:Georgia,serif;line-height:1.1;margin:0 0 16px}h1{font-size:clamp(38px,6vw,76px)}h2{font-size:26px}.notice{font-size:14px;color:#475569}.layout{display:grid;grid-template-columns:1.4fr 1fr;gap:28px;align-items:start}.plans{display:grid;gap:12px}.plan{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:start;padding:21px;background:white;border:1px solid #dadfe3;border-radius:12px;cursor:pointer}.plan:has(input:checked){border:2px solid #254762;padding:20px;background:#f4f9fc}.plan input{margin-top:6px;accent-color:#254762}.plan b,.plan small{display:block}.plan p{font-size:14px;margin:7px 0 0;color:#4b5969}.plan strong{white-space:nowrap;color:#173a55}aside{background:#fff;border:1px solid #dedbd3;border-radius:16px;padding:26px;box-shadow:0 16px 45px #173a5510}dl{margin:20px 0}dl div{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eceff1}dl div[hidden]{display:none}dd{margin:0;font-weight:700;text-align:right}.total{font-size:24px;color:#173a55;font-weight:700}button{width:100%;padding:15px;background:#173a55;border:none;border-radius:6px;color:white;font-weight:bold}button:disabled{opacity:.62;cursor:not-allowed}.fine{font-size:13px;color:#536274}a{color:#173a55}footer{font-size:13px;border-top:1px solid #dedbd3;color:#536274}@media(max-width:760px){header{align-items:flex-start;flex-direction:column;padding:18px 20px}main{padding:32px 20px 48px}.layout{grid-template-columns:1fr}.plan{padding:15px}.plan:has(input:checked){padding:14px}aside{padding:20px}}
